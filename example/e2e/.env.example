# Sao chép thành .env rồi điền giá trị THẬT của môi trường test. KHÔNG commit .env.
# Giá trị trong test.md chỉ là DEMO — dùng thẳng là biến ví dụ thành sự thật.

E2E_BASE_URL=http://localhost:3000

# Bắt buộc — tài khoản ACTIVE bình thường
E2E_USER=
E2E_PASS=

# S01 Login
E2E_LOCKED_USER=          # tài khoản PERM_LOCKED
E2E_ADMIN_TOKEN=          # token gọi API test-only để seed fail_count / trạng thái khoá

# S02 Dashboard
E2E_LEAD=
E2E_LEAD_PASS=
E2E_ADMIN=
E2E_ADMIN_PASS=

# S03 TaskDetail
E2E_MEMBER=
E2E_MEMBER_PASS=
E2E_MEMBER2=              # thành viên THỨ HAI — cần cho ca giao việc/đua thao tác giữa hai người
E2E_MEMBER2_PASS=

# S05 Organization
E2E_TEMP_USER=            # tài khoản còn cờ phai_doi_mat_khau
E2E_TEMP_PASS=
E2E_BETA_ADMIN=           # Org Admin của tổ chức KHÁC (kiểm cách ly tenant)
E2E_BETA_PASS=

# S06 Register
E2E_EXISTING_EMAIL=       # email đã đăng ký, để kiểm 409
E2E_RUN_ID=local          # hậu tố tạo email mới mỗi lần chạy
